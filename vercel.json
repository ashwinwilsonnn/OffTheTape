{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page-home"
    },
    {
      "source": "/news/:slug",
      "destination": "/api/page-article?slug=:slug"
    },
    {
      "source": "/hub/:lg",
      "destination": "/api/page-hub?lg=:lg"
    },
    {
      "source": "/hub/:lg/:tab",
      "destination": "/api/page-hub?lg=:lg&tab=:tab"
    },
    {
      "source": "/team/:id",
      "destination": "/api/page-team?id=:id"
    },
    {
      "source": "/scores",
      "destination": "/api/page-scores"
    },
    {
      "source": "/newsletter",
      "destination": "/api/subscribe"
    },
    {
      "source": "/legal/:k",
      "destination": "/api/page-legal?k=:k"
    },
    {
      "source": "/approve",
      "destination": "/api/approve"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/news-sitemap.xml",
      "destination": "/api/sitemap?n=1"
    }
  ],
  "images": {
    "sizes": [
      160,
      320,
      640,
      828,
      1200
    ],
    "qualities": [
      50,
      75
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "minimumCacheTTL": 2592000,
    "dangerouslyAllowSVG": false,
    "contentDispositionType": "inline",
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "avp.com"
      },
      {
        "protocol": "https",
        "hostname": "www.lovb.com"
      },
      {
        "protocol": "https",
        "hostname": "images.volleyballworld.com"
      },
      {
        "protocol": "https",
        "hostname": "worldofvolley.com"
      },
      {
        "protocol": "https",
        "hostname": "huskers.com"
      }
    ]
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/approve",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-feeds",
      "schedule": "0 12 * * *"
    }
  ]
}
